#version 450

// Generic single-axis reduction for contiguous tensors.
//
// A contiguous tensor reduced along `dim` is viewed as [outer, dim, inner]:
//   out[o, i] = reduce_d( in[o, d, i] )
// which covers every axis, including the last (inner == 1, the case the
// specialised kernel handles) and axis 0 (outer == 1), without a host round
// trip. Each workgroup produces one output element.

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer BufferIn {
    float dataIn[];
};

layout(std430, binding = 1) writeonly buffer BufferOut {
    float dataOut[];
};

layout(push_constant) uniform PushConstants {
    uint outer;
    uint dim_size;
    uint inner;
    uint op_type; // 0: Sum, 1: Max, 2: Min
} pc;

shared float s_data[128];

float reduce_op(float a, float b, uint op) {
    if (op == 0u) return a + b;
    if (op == 1u) return max(a, b);
    if (op == 2u) return min(a, b);
    return a + b;
}

float init_val(uint op) {
    if (op == 0u) return 0.0;
    if (op == 1u) return -3.402823466e+38;
    if (op == 2u) return 3.402823466e+38;
    return 0.0;
}

void main() {
    uint out_idx = gl_WorkGroupID.x;
    uint total_out = pc.outer * pc.inner;
    if (out_idx >= total_out) return;

    uint o = out_idx / pc.inner;
    uint i = out_idx % pc.inner;
    uint base = o * pc.dim_size * pc.inner + i;

    uint tid = gl_LocalInvocationID.x;

    float acc = init_val(pc.op_type);
    for (uint d = tid; d < pc.dim_size; d += 128u) {
        acc = reduce_op(acc, dataIn[base + d * pc.inner], pc.op_type);
    }

    s_data[tid] = acc;
    barrier();

    for (uint stride = 64u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            s_data[tid] = reduce_op(s_data[tid], s_data[tid + stride], pc.op_type);
        }
        barrier();
    }

    if (tid == 0u) {
        dataOut[out_idx] = s_data[0];
    }
}
