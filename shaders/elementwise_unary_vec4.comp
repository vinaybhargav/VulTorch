#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer BufferIn {
    vec4 dataIn[];
};

layout(std430, binding = 1) writeonly buffer BufferOut {
    vec4 dataOut[];
};

layout(push_constant) uniform PushConstants {
    uint num_vec4;
    uint op_type;
    float param1;
    float param2;
} pc;

const float SQRT_2_OVER_PI = 0.7978845608;
const float GELU_COEFF = 0.044715;

vec4 fast_gelu(vec4 x) {
    vec4 inner = SQRT_2_OVER_PI * (x + GELU_COEFF * x * x * x);
    return 0.5 * x * (vec4(1.0) + tanh(inner));
}

vec4 apply_op_vec4(vec4 x, uint op) {
    switch (op) {
        case 0u: return -x;
        case 1u: return exp(x);
        case 2u: return log(x);
        case 3u: return sqrt(x);
        case 4u: return inversesqrt(x);
        case 5u: return abs(x);
        case 6u: return sin(x);
        case 7u: return cos(x);
        case 8u: return tanh(x);
        case 9u: return vec4(1.0) / (vec4(1.0) + exp(-x));
        case 10u: return max(x, vec4(0.0));
        case 11u: return fast_gelu(x);
        case 12u: return x / (vec4(1.0) + exp(-x));
        case 13u: return clamp(x, vec4(pc.param1), vec4(pc.param2));
        case 14u: return sign(x);
        case 15u: return x * pc.param1 + pc.param2; // scale and shift
        default: return x;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_vec4) return;

    dataOut[idx] = apply_op_vec4(dataIn[idx], pc.op_type);
}
