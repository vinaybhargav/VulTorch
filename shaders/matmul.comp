#version 450
#extension GL_EXT_control_flow_attributes : enable

#define TILE_M 32
#define TILE_N 32
#define TILE_K 16

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer BufferA {
    float dataA[];
};

layout(std430, binding = 1) readonly buffer BufferB {
    float dataB[];
};

layout(std430, binding = 2) writeonly buffer BufferC {
    float dataC[];
};

layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
    uint batch_count;
    uint strideA_b;
    uint strideA_m;
    uint strideA_k;
    uint strideB_b;
    uint strideB_k;
    uint strideB_n;
    uint strideC_b;
    uint strideC_m;
    uint strideC_n;
} pc;

shared float s_A[TILE_M][TILE_K];
shared float s_B[TILE_K][TILE_N];

void main() {
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;

    uint block_x = gl_WorkGroupID.x; // Tile along N (stride of 32)
    uint block_y = gl_WorkGroupID.y; // Tile along M (stride of 32)
    uint batch_idx = gl_WorkGroupID.z;

    if (batch_idx >= pc.batch_count) return;

    uint row0 = block_y * TILE_M + ty;
    uint row1 = row0 + 16;

    uint col0 = block_x * TILE_N + tx;
    uint col1 = col0 + 16;

    uint baseA = batch_idx * pc.strideA_b;
    uint baseB = batch_idx * pc.strideB_b;
    uint baseC = batch_idx * pc.strideC_b;

    float acc00 = 0.0;
    float acc01 = 0.0;
    float acc10 = 0.0;
    float acc11 = 0.0;

    uint num_tiles = (pc.K + TILE_K - 1) / TILE_K;

    for (uint t = 0; t < num_tiles; ++t) {
        uint k_base = t * TILE_K;

        // Cooperative load tile of A: 32 rows x 16 cols
        // Thread (tx, ty) loads (ty, tx) and (ty + 16, tx)
        uint k_idx = k_base + tx;
        if (row0 < pc.M && k_idx < pc.K) {
            s_A[ty][tx] = dataA[baseA + row0 * pc.strideA_m + k_idx * pc.strideA_k];
        } else {
            s_A[ty][tx] = 0.0;
        }

        if (row1 < pc.M && k_idx < pc.K) {
            s_A[ty + 16][tx] = dataA[baseA + row1 * pc.strideA_m + k_idx * pc.strideA_k];
        } else {
            s_A[ty + 16][tx] = 0.0;
        }

        // Cooperative load tile of B: 16 rows x 32 cols
        // Thread (tx, ty) where ty < 16, loads (ty, tx) and (ty, tx + 16)
        uint b_k = k_base + ty;
        if (b_k < pc.K && col0 < pc.N) {
            s_B[ty][tx] = dataB[baseB + b_k * pc.strideB_k + col0 * pc.strideB_n];
        } else {
            s_B[ty][tx] = 0.0;
        }

        if (b_k < pc.K && col1 < pc.N) {
            s_B[ty][tx + 16] = dataB[baseB + b_k * pc.strideB_k + col1 * pc.strideB_n];
        } else {
            s_B[ty][tx + 16] = 0.0;
        }

        barrier();

        // Accumulate outer products in private registers
        [[unroll]]
        for (uint k = 0; k < TILE_K; ++k) {
            float a0 = s_A[ty][k];
            float a1 = s_A[ty + 16][k];
            float b0 = s_B[k][tx];
            float b1 = s_B[k][tx + 16];

            acc00 = fma(a0, b0, acc00);
            acc01 = fma(a0, b1, acc01);
            acc10 = fma(a1, b0, acc10);
            acc11 = fma(a1, b1, acc11);
        }

        barrier();
    }

    // Store results
    if (row0 < pc.M) {
        if (col0 < pc.N) dataC[baseC + row0 * pc.strideC_m + col0 * pc.strideC_n] = acc00;
        if (col1 < pc.N) dataC[baseC + row0 * pc.strideC_m + col1 * pc.strideC_n] = acc01;
    }
    if (row1 < pc.M) {
        if (col0 < pc.N) dataC[baseC + row1 * pc.strideC_m + col0 * pc.strideC_n] = acc10;
        if (col1 < pc.N) dataC[baseC + row1 * pc.strideC_m + col1 * pc.strideC_n] = acc11;
    }
}
