#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer BufferGradOut {
    float gradOut[];
};

layout(std430, binding = 1) readonly buffer BufferIndices {
    uint maxIndices[];
};

layout(std430, binding = 2) buffer BufferGradIn {
    float gradIn[];
};

layout(push_constant) uniform PushConstants {
    uint total_out_elements;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total_out_elements) return;

    uint in_idx = maxIndices[idx];
    // Atomic add or direct assignment
    // For disjoint pooling windows (stride >= kernel), indices are unique
    gradIn[in_idx] += gradOut[idx];
}
